[
  {
    "doctype": "oiCommandTemplate",
    "template_name": "Перезапуск служби Windows",
    "description": "Безпечний перезапуск служби Windows по імені",
    "enabled": 1,
    "command_type": "Restart Service",
    "risk_level": "Medium",
    "requires_approval": 0,
    "command_template": "{service_name}",
    "allowed_parameters": "{\"service_name\": {\"type\": \"string\", \"pattern\": \"^[a-zA-Z0-9_-]+$\", \"max_length\": 256}}",
    "max_timeout_seconds": 120,
    "allowed_roles": "System Manager, Maintenance Manager"
  },
  {
    "doctype": "oiCommandTemplate",
    "template_name": "Отримати статус служби",
    "description": "Перевірка стану служби Windows",
    "enabled": 1,
    "command_type": "PowerShell",
    "risk_level": "Low",
    "requires_approval": 0,
    "command_template": "Get-Service -Name '{service_name}' | Select-Object Name, Status, StartType",
    "allowed_parameters": "{\"service_name\": {\"type\": \"string\", \"pattern\": \"^[a-zA-Z0-9_-]+$\", \"max_length\": 256}}",
    "max_timeout_seconds": 30,
    "allowed_roles": ""
  },
  {
    "doctype": "oiCommandTemplate",
