    "max_timeout_seconds": 120,
    "allowed_roles": "System Manager, Maintenance Manager"
  },
  {
    "doctype": "oiCommandTemplate",
    "template_name": "Перевірка Windows Update",
    "description": "Перевірити наявність оновлень Windows",
    "enabled": 1,
    "command_type": "PowerShell",
    "risk_level": "Low",
    "requires_approval": 0,
    "command_template": "$UpdateSession = New-Object -ComObject Microsoft.Update.Session; $UpdateSearcher = $UpdateSession.CreateupdateSearcher(); $Updates = $UpdateSearcher.Search('IsInstalled=0'); $Updates.Updates | Select-Object Title, MsrcSeverity",
    "allowed_parameters": "{}",
    "max_timeout_seconds": 300,
