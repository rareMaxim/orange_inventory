    "enabled": 1,
    "command_type": "PowerShell",
    "risk_level": "Medium",
    "requires_approval": 0,
    "command_template": "Remove-Item -Path \"$env:TEMP\\*\" -Recurse -Force -ErrorAction SilentlyContinue; Write-Host 'Temp files cleaned'",
