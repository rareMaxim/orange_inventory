    "command_template": "$UpdateSession = New-Object -ComObject Microsoft.Update.Session; $UpdateSearcher = $UpdateSession.CreateupdateSearcher(); $Updates = $UpdateSearcher.Search('IsInstalled=0'); $Updates.Updates | Select-Object Title, MsrcSeverity",
    "allowed_parameters": "{}",
    "max_timeout_seconds": 300,
