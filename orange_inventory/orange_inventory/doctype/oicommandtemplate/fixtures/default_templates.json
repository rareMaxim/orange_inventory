    "enabled": 1,
    "command_type": "PowerShell",
    "risk_level": "Low",
    "requires_approval": 0,
    "command_template": "Get-PSDrive -PSProvider FileSystem | Select-Object Name, @{N='Used(GB)';E={[math]::Round($_.Used/1GB,2)}}, @{N='Free(GB)';E={[math]::Round($_.Free/1GB,2)}}",
    "allowed_parameters": "{}",
    "max_timeout_seconds": 30,
    "allowed_roles": ""
  },
  {
    "doctype": "oiCommandTemplate",
    "template_name": "Мережеві підключення",
