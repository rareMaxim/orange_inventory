    "enabled": 1,
    "command_type": "PowerShell",
    "risk_level": "Low",
    "requires_approval": 0,
    "command_template": "Get-Process | Sort-Object CPU -Descending | Select-Object -First 20 Name, CPU, WorkingSet64",
